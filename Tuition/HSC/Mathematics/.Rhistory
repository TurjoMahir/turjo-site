4,2,3,8,8
)
reaction_data <- data.frame(
batch = as.factor(batch),
day = as.factor(day),
ingredient = as.factor(ingredient),
reaction = reaction
)
reaction_data
# Sizes
p <- 5
N <- p^2
# Degrees of freedoms
df.row <- df.col <- df.trt <- p-1
df.err <- (p-1)*(p-2)
tot.sum <- sum(reaction_data)
# Sums
attach(reaction_data)
# Sums
attach(reaction_data)
trt.sum <- tapply(reaction, ingredient , sum)
row.sum <- tapply(reaction, batch , sum)
col.sum <- tapply(reaction, day , sum)
