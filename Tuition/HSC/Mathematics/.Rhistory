# Boxplot for Visual Analysis
boxplot(etch_rate ~ power, data = Etch)
# Boxplot for Visual Analysis
par(mfrow = c(1,1))
boxplot(etch_rate ~ power, data = Etch)
# Perform ANOVA for CRD
crd_result <- aov(etch_rate ~ power, data = Etch)
# Display ANOVA Table
summary(crd_result)
qf(0.05,3,16,lower.tail = F)
qf(0.95,3,16,lower.tail = F)
qf(0.05,3,16,lower.tail = F)
# Model Adequacy Check
treat_mean <- tapply(etch_rate, power, mean)
treat_estimate <- rep(treat_mean, each = 5)
residual <- etch_rate - treat_estimate
residual
residuals(crd_result) # Short
qqnorm(residual)
qqnorm(residual)
qqline(residual)
plot(fitted(crd_result), residuals(crd_result))
treat_mean
# Mean Comparisons
# Tukey's Honest Significant Difference Test
TukeyHSD(crd_result)
