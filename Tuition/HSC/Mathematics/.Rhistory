# Define blocks: 4 blocks repeated for each treatment
block <- rep(c(1, 2, 3, 4), times = 6)
# Combine the data into a data frame
data <- data.frame(raw_data, treat, block)
# Size
a <- 6
b <- 4
N <- a*b
df.trt <- a-1
df.blc <- b-1
df.tot <- N-1
df.err <- df.tot - df.trt - df.blc
attach(data)
tot.sum <- sum(raw_data)
trt.sum <- tapply(raw_data, treat, sum)
blc.sum <- tapply(raw_data, block, sum)
tot.mean <- mean(raw_data)
trt.mean <- tapply(raw_data, treat, mean)
blc.mean <- tapply(raw_data, block, mean)
# SS calc
cf <- tot.sum^2 / N
ss.tot <- sum(raw_data^2) - cf
ss.trt <- sum(trt.sum^2 / b) - cf
ss.blc <- sum(blc.sum^2 / a) - cf
ss.err <- ss.tot - ss.trt - ss.blc
# MS calc
ms.trt <- ss.trt / df.trt
ms.blc <- ss.blc / df.blc
ms.err <- ss.err / df.err
# F values
f.trt.est <- ms.trt / ms.err
f.blc.est <- ms.blc / ms.err
# F table
f.trt.tab <- qf(0.05,df.trt,df.err, lower.tail = FALSE)
f.blc.tab <- qf(0.05,df.blc,df.err, lower.tail = FALSE)
# Conclution
ifelse(f.trt.est > f.trt.tab, "At least one treatment mean differs",
"There is no significant difference between means")
ifelse(f.blc.est > f.blc.tab, "At least one block mean differs",
"All means are equal")
# Treatment & block effect
list(
`treatment effect` = c(trt.mean - tot.mean),
`block effect` = c(blc.mean - tot.mean)
)
analysis <- aov(raw_data ~ treat + block, data = data)
summary(analysis)
data$treat <- as.factor(data$treat)
analysis <- aov(raw_data ~ treat + block, data = data)
data$treat <- as.factor(data$treat)
data$block <- as.factor(data$block)
analysis <- aov(raw_data ~ treat + block, data = data)
summary(analysis)
residuals(analysis)
residual <- raw_data - trt - blc + tot.mean
residual
plot(analysis)
qqnorm(analysis)
qqnorm(residual)
qqnorm(residual)
qqline(residual)
qqplot(analysis)
qqplot(fitted(analysis),residuals(analysis))
plot(fitted(analysis),residuals(analysis))
